{{!
    @template local_kopere_dashboard/php_security_notice
}}
<aside class="kopere_dashboard-php-security-notice" role="alert"
       aria-labelledby="kopere-dashboard-php-security-title">
    <span class="kopere_dashboard-php-security-symbol" aria-hidden="true">!</span>
    <div class="kopere_dashboard-php-security-content">
        <span class="kopere_dashboard-php-security-label">
            {{#str}}php_security_notice_label, local_kopere_dashboard{{/str}}
        </span>
        <h2 id="kopere-dashboard-php-security-title">
            {{#str}}php_security_notice_title, local_kopere_dashboard{{/str}}
        </h2>
        <p>{{php_security_description}}</p>
        <p class="kopere_dashboard-php-security-cves">CVE-2026-109618 &middot; CVE-2026-109619</p>
        <a href="https://www.php.net/archive/2026.php#2026-10-21-5"
           target="_blank" rel="noopener noreferrer">
            {{#str}}php_security_notice_details, local_kopere_dashboard{{/str}} &#8599;
        </a>
    </div>
    <form class="kopere_dashboard-php-security-dismiss" method="post" action="{{php_security_dismiss_url}}">
        <input type="hidden" name="sesskey" value="{{php_security_sesskey}}">
        <input type="hidden" name="dismissphpsecuritynotice" value="1">
        <button type="submit" title="{{#str}}php_security_notice_dismiss, local_kopere_dashboard{{/str}}"
                aria-label="{{#str}}php_security_notice_dismiss, local_kopere_dashboard{{/str}}">&times;</button>
    </form>
</aside>
